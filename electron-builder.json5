{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.lexisai.app",
  productName: "LexisIA",
  asar: true,

  directories: {
    output: "release/${version}",
    buildResources: "build",
  },

  files: [
    "dist/**/*",
    "dist-electron/**/*",
    "!python/venv/**/*",
    "!python/dist/**/*",
    "!python/build/**/*",
    "!python/transcription.py",
    "!python/transcription.spec",
  ],

  extraResources: [
    { from: "build/icon.ico", to: "build/icon.ico" },
    {
      from: "python/dist/transcription.exe",
      to: "python/dist/transcription.exe",
    },
    { from: "python/bin/ffmpeg.exe", to: "python/bin/ffmpeg.exe" },
    { from: "python/audios", to: "python/audios" },
  ],

  win: {
    target: [{ target: "nsis", arch: ["x64"] }],
    icon: "build/icon.ico",
    executableName: "LexisAI",
    artifactName: "${productName}-Setup-${version}.${ext}",
  },

  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },

  mac: {
    target: ["dmg"],
    icon: "build/icon.icns",
    artifactName: "${productName}-Mac-${version}-Installer.${ext}",
  },

  linux: {
    target: ["AppImage"],
    icon: "build/icon.png",
    artifactName: "${productName}-Linux-${version}.${ext}",
  },
}
